#!/usr/bin/env bash
#
# Download the prebuilt {{ package_name }} {{ version }} rpm for the distro of this system.
#
# Generated from a Jinja2 template; do not edit the rendered script by hand.
# specbuilder names it like a spec file: scripts/build_rpms.sh runs it instead of rpmbuild.
#
# {{ organization }}/{{ repository }} builds an rpm per distro, named after %{dist} (e.g. .el9 or .fc42), like
# {{ package_name }}-<version>-1.el9.{{ package_arch }}.rpm.
# Distros it does not build for are skipped with a warning.
#
# Usage: bash {{ name }}-{{ package_arch }}.spec
#   RPMDEST  directory to write the rpm to (default: ./rpms)

set -euo pipefail

RPMDEST="${RPMDEST:-$(pwd)/rpms}"
DIST="$(rpm --eval '%{?dist}')"
if [ -z "${DIST}" ]; then
  echo "ERROR: %{dist} is not set on this system, so the {{ package_name }} rpm to download is unknown" >&2
  exit 1
fi

# <asset name> <url>
ASSETS=(
{% for asset in assets %}  "{{ asset.name }} {{ asset.url }}"
{% endfor %})

for ASSET in "${ASSETS[@]}"; do
  NAME="${ASSET%% *}"
  URL="${ASSET#* }"
  [[ "${NAME}" == *"${DIST}.{{ package_arch }}.rpm" ]] || continue
  echo "Downloading ${URL}"
  mkdir -p "${RPMDEST}"
  curl -fsSL --retry 3 -o "${RPMDEST}/${NAME}" "${URL}"
  echo "Downloaded ${RPMDEST}/${NAME}"
  exit 0
done

echo "WARNING: {{ organization }}/{{ repository }} {{ version }} has no {{ package_name }} rpm for ${DIST}, skipping" >&2
