Summary: {{ description or package_name }}
Name: {{ package_name }}
# strip the tag's leading "v"
Version: %(v="{{ version }}"; echo "${v#v}")
# 2: the binaries moved from /usr/local/bin to /usr/bin
Release: 2%{?dist}
License: {{ license }}
Group: {{ group | default('Unspecified') }}
Url: {{ url }}
{% for asset in assets %}Source{{ loop.index0 }}: {{ asset.name }}
{% endfor %}BuildArch: {{ package_arch | default('x86_64') }}
{% for require in requires %}Requires: {{ require }}
{% endfor %}{% for provide in provides %}Provides: {{ provide }}
{% endfor %}
%description
{{ description or package_name }}

%prep
mkdir -p %{_sourcedir}
{% for asset in assets %}curl -L {{ asset.url }} -o %{_sourcedir}/{{ asset.name }}
{% endfor %}
{% for cmd in prep %}{{ cmd }}
{% endfor %}

%install
mkdir -p %{buildroot}/%{_bindir}
{% for asset in assets %}{{ extract | default('tar -xvf') }} %{_sourcedir}/{{ asset.name }}
{% endfor %}
{% for file in files %}%{__install} -m {{ file.mode | default('0755') }} %{_builddir}/{{file.src}} %{buildroot}/{{file.dest}}
{% endfor %}

%clean
rm -rf $RPM_BUILD_ROOT

%files
{% for file in files %}{{ file.dest }}
{% endfor %}
